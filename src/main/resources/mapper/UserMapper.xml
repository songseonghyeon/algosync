<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
        namespace="com.algosync.backend.domain.users.UserRepository">
    <!-- 등록된 사용자 전체를 조회합니다. -->
    <select id="selectUser">
        select * from users
    </select>

    <!-- 사용자 ID로 등록 정보를 조회합니다. -->
    <select id="selectOneUser">
        select * from users where user_id = #{userId}
    </select>

    <!-- 새 사용자 ID를 저장합니다. -->
    <insert id="insertUserId">
        insert into users (user_id) values (#{userId})
    </insert>
</mapper>
